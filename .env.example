# ---------------------------------------------------------------- database
# PostgreSQL (Supabase). DATABASE_URL is the transaction-pooler connection used
# by the app at runtime; DIRECT_URL is the session-pooler connection used by
# Prisma Migrate. Supabase dashboard -> Project Settings -> Database.
#
# The transaction pooler MUST include pgbouncer=true, otherwise Prisma prepared
# statements collide under load ("prepared statement already exists").
# connection_limit=5 is appropriate for one Render service; use a lower limit
# for serverless deployments. pool_timeout=30 gives a cold pool time to connect.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- tests
# Create a git-ignored .env.test.local with a SEPARATE schema (never public).
# `npm test` drops and recreates this schema on every run.
# TEST_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?schema=logbook_test&pgbouncer=true&connection_limit=5&pool_timeout=30"
# TEST_DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=logbook_test"

# ---------------------------------------------------------------- auth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me-with-a-long-random-secret"
# Local dev below. In production set this to the live URL (and redeploy),
# e.g. NEXTAUTH_URL="https://be-logbook.vercel.app"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- separate API backend
API_BASE_URL="http://localhost:4000"
# Must match apps/api's API_INTERNAL_SECRET. Keep this server-side only.
API_INTERNAL_SECRET="replace-with-a-long-random-secret-shared-with-the-api"

# Restrict student self sign-up to one email domain. Leave empty to allow any.
# Example: ALLOWED_EMAIL_DOMAIN="apcoer.edu.in"
ALLOWED_EMAIL_DOMAIN=""

# ---------------------------------------------------------------- email & Brevo
# Provider mode: "brevo-api" | "smtp" | "brevo" | "console" | "noop" | "resend"
# (Auto-defaults to "brevo-api" when BREVO_API_KEY is set, or "smtp" when SMTP credentials are set)
EMAIL_PROVIDER="console"

# Verified sender email in Brevo or Resend:
EMAIL_FROM="Digital BE Project Logbook <no-reply@apcoer.edu.in>"

# OPTION 1: Brevo Transactional Email REST API over HTTPS (Recommended for Render)
# Eliminates port 587 cloud blocks and 525 Unauthorized IP restrictions.
# Generate in Brevo -> SMTP & API -> API Keys (starts with xkeysib-).
BREVO_API_KEY=""

# OPTION 2: Brevo SMTP
# For production Brevo SMTP, configure host, port, login, and SMTP key.
# Note: If using Brevo SMTP on cloud platforms with dynamic IPs (Render),
# you must deactivate "Blocking unauthorized IP addresses for API keys and SMTP keys"
# in Brevo Dashboard -> Settings -> Security -> Authorized IPs.
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your_brevo_smtp_login"
BREVO_SMTP_PASSWORD="your_brevo_smtp_key"

# Fallback standard SMTP credentials:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Fallback Resend REST API:
RESEND_API_KEY=""

# Demo kill-switch for email verification. Default (absent or anything but
# "false") requires new students to click the verification link before login.
# Set to "false" for demos so accounts activate instantly with no mailbox;
# flip it back afterwards to restore the normal flow.
# REQUIRE_EMAIL_VERIFICATION="false"

# Shared auth rate limits for the Vercel/serverless deployment (Upstash Redis REST).
# Required in production; local development falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------- uploads
# "local" writes to var/uploads in dev (served by the /media route).
# "supabase" uploads to private Supabase Storage buckets in production.
UPLOAD_PROVIDER="local"
# Supabase project URL + existing uploads bucket. SUPABASE_SERVICE_ROLE_KEY is server-side only: it
# bypasses storage policies, so never expose it to the browser or commit it.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="logbook-uploads"
# Create this as a PRIVATE bucket. New photos, evidence files and PDFs use it.
SUPABASE_PRIVATE_BUCKET="logbook-private-uploads"
# Create this as a separate PRIVATE bucket for generated full logbooks.
SUPABASE_PDF_BUCKET="logbook-pdfs"

# ---------------------------------------------------------------- pdf
# Base URL the Puppeteer renderer uses to load /print/[groupId]. Local dev
# below; in production set this to the live URL (and redeploy).
PDF_BASE_URL="http://localhost:3000"
# Optional local Chrome/Chromium executable. Vercel uses the bundled
# @sparticuz/chromium package when CHROME_PATH and local Chrome are absent.
# Example: CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
CHROME_PATH=""
