# ---------------------------------------------------------------- server
API_PORT=4000
API_ALLOWED_ORIGINS="http://localhost:3000,https://be-logbook.vercel.app"
API_INTERNAL_SECRET="replace-with-a-long-random-secret-shared-with-the-api"

# ---------------------------------------------------------------- database
# PostgreSQL (Supabase / Render). Runtime pooler connection with pgbouncer=true.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- frontend web URL
# Used to build email verification and password reset links (e.g. https://your-app.vercel.app).
WEB_URL="http://localhost:3000"

# ---------------------------------------------------------------- auth & rules
ALLOWED_EMAIL_DOMAIN=""
REQUIRE_EMAIL_VERIFICATION="true"

# ---------------------------------------------------------------- email
# Providers (EMAIL_PROVIDER):
#   - "brevo-api" : Brevo Transactional Email REST API over HTTPS (Recommended for Render)
#   - "smtp"      : Brevo SMTP (smtp-relay.brevo.com:587) or generic SMTP
#   - "brevo"     : Alias for "smtp" with Brevo credentials
#   - "resend"    : Resend REST API
#   - "console"   : Prints emails to server terminal (dev default)
#   - "noop"      : Discards emails silently (automated tests)
EMAIL_PROVIDER="console"

# Sender address must be an authorized/verified sender in your Brevo or Resend account
EMAIL_FROM="Digital BE Project Logbook <no-reply@apcoer.edu.in>"

# OPTION 1: Brevo Transactional Email REST API over HTTPS (Recommended on Render)
# Eliminates port 587 cloud blocks and 525 Unauthorized IP restrictions.
# Generate API key in Brevo -> SMTP & API -> API Keys (starts with xkeysib-).
BREVO_API_KEY=""

# OPTION 2: Brevo SMTP (or standard SMTP)
# If using Brevo SMTP, you must deactivate "Blocking unauthorized IP addresses for API keys and SMTP keys"
# in Brevo Dashboard -> Settings -> Security -> Authorized IPs (or allow Render outbound IPs).
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your_brevo_smtp_login"
BREVO_SMTP_PASSWORD="your_brevo_smtp_key"

# Fallback generic SMTP credentials:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Fallback Resend API:
RESEND_API_KEY=""

# ---------------------------------------------------------------- storage
UPLOAD_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="logbook-uploads"
SUPABASE_PRIVATE_BUCKET="logbook-private-uploads"
